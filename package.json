{
  "name": "genshin-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "update-data": "tsx scripts/update-data.ts && tsx scripts/build-farm-data.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "dev": "concurrently -k -n api,web \"BROWSER_LOGIN=1 tsx watch server/src/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "BROWSER_LOGIN=1 tsx server/src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "genshin-db": "^5.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
